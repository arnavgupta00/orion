{
  "name": "orion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "deploy": "pnpm build && wrangler deploy",
    "preview": "vite preview",
    "sync:career": "node scripts/sync-career-evidence.mjs",
    "sync:career:check": "node scripts/sync-career-evidence.mjs --check",
    "worker:types": "wrangler types",
    "worker:check": "wrangler deploy --dry-run",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/antonio": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/space-grotesk": "^5.2.10",
    "@mediapipe/tasks-vision": "^0.10.35",
    "dompurify": "^3.3.0",
    "marked": "^16.4.2",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.45.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.10.0",
    "@types/three": "^0.185.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.111.0"
  }
}
